{
  "layer": "top",
  "modules-left": [
    "clock",
    "custom/weather"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "privacy",
    "mpris",
    "wireplumber",
    "network",
    "upower",
    "tray"
  ],
  "clock": {
    "format": "{:%a, %d %b %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "locale": "de_DE.UTF-8",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": {
        "months":   "<span color='#ffead3'><b>{}</b></span>",
        "days":     "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks":    "<span color='#99ffdd'><b>{:%W}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today":    "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up"
    }
  },
  "custom/weather": {
    "exec": "/usr/bin/waybar-weather",
    "restart-interval": 60,
    "return-type": "json",
    "hide-empty-text": true,
    "on-click": "pkill -USR1 waybar-weather"
  },
  "privacy": {
    "icon-size": 0
  },
  "mpris": {
    "format": "{player_icon}  {artist} - {title}",
    "format-paused": "{status_icon}  {artist} - {title}",
    "player-icons": {
      "default": "♪",
      "firefox": "󰈹",
      "spotify": "󰓇",
      "mpv": "󰝚"
    },
    "status-icons": {
      "paused": "⏸"
    },
    "ignored-players": []
  },
  "wireplumber": {
    "format": "{icon} {volume}% {node_name}",
    "format-icons": ["", "", ""],
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": " 󰈁",
    "format-tooltip": "{ipaddr}"
  },
  "battery": {
    "format-discharging": "{icon} {time} ({capacity})",
    "format-charging": " {capacity}",
    "format-full": "",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{power}"
  },
  "upower": {
    "format": "{percentage} ({time})",
    "tooltip-format": "{percentage} ({time})",
    "icon-size": 0,
    "show-icon": false
  }
}
